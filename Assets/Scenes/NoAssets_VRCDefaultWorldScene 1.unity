    - target: {fileID: 6919858721732568716, guid: 1429f4ce574e8874c9277ec8a7307d2e,
        type: 3}
      propertyPath: m_text
      value: "La Chasse aux R\xEAves\r\nby Les Ma\xE7ons de l'Imaginaire\r\n\r\nThe
        Dream Hunt is a poetic world in which players collaborate to awaken alien
        frozen in pods\u2024 As players fish for asteroids\u201A the environment
        slowly shifts from winter to spring\u201A guided by a custom spatial music
        system that adapt to the current season\u2024\r\n(text work in progress)\r\n\r\nLes
        Ma\xE7ons de l'Imaginaire is a French non profit organization which goal
        is to create virtual worlds.\r\n\r\nRomane \"redmarian16\" - Game Designer
        & UI Designer\r\nNiccolo \"NicoSca\" - 3D Artist\r\nCatherine \"Ri Lomako\"
        - Product Owner\r\nAntoine \"Anthonaar' - Programmer & Association President\r\nYali
        Arbel \"YaliAR\" - Music Composer & Sound Designer"
      objectReference: {fileID: 0}
    - target: {fileID: 6919858721732568716, guid: 1429f4ce574e8874c9277ec8a7307d2e,
        type: 3}
      propertyPath: m_fontSize
      value: 24
      objectReference: {fileID: 0}
    - target: {fileID: 6919858721732568716, guid: 1429f4ce574e8874c9277ec8a7307d2e,
        type: 3}
      propertyPath: m_fontSizeBase
      value: 24
      objectReference: {fileID: 0}
